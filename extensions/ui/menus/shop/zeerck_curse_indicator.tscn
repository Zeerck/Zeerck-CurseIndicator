[sub_resource type="GDScript" id=1]
script/source = "extends HBoxContainer

onready var zeerck_curse_indicator_label = $ZeerckCurseIndicatorLabel
onready var zeerck_curse_indicator_amount = $ZeerckCurseIndicatorAmount


func set_zeerck_curse_indicator_amount(curse_amount: float)->void:
	zeerck_curse_indicator_amount.text = str(curse_amount * 100) + \"%\"
"

